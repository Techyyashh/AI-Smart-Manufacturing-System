# Copy this file to .env and fill in your own values
MONGO_URI=mongodb://localhost:27017/smart-manufacturing
PORT=5000
ML_URL=http://localhost:8000

# Counters (hours, energy, parts) run this many times faster than real time
# so a full shift fits in a demo. Set to 1 for real time.
SIM_SPEED=60

# Electricity price in rupees per kWh
ENERGY_TARIFF=8

# Secret key used to sign login tokens - set any long random text
JWT_SECRET=change-this-to-a-long-random-string
